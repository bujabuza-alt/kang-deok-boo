# 기기 간 동기화(Firebase) 설정 예시 파일입니다.
# 이 내용을 복사해 .env.local 파일을 만들고 실제 값을 채워 넣으세요.
# (.env.local은 .gitignore에 등록되어 있어 커밋되지 않습니다.)
#
# 값은 Firebase 콘솔(console.firebase.google.com) → 프로젝트 설정 →
# 일반 → "내 앱" → SDK 설정 및 구성에서 확인할 수 있습니다.
# 자세한 설정 절차는 docs/SYNC_SETUP.md 를 참고하세요.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
